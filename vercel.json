{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/generate", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/u/:handle/badge.svg", "destination": "/api/badge?handle=:handle" },
    { "source": "/u/:handle/embed", "destination": "/api/embed?handle=:handle" },
    { "source": "/u/:handle/pair/:other", "destination": "/api/compare-page?a=:other&b=:handle" },
    { "source": "/u/:handle", "destination": "/api/profile?handle=:handle" },
    { "source": "/compare", "destination": "/api/compare-page" },
    { "source": "/browse", "destination": "/browse.html" },
    { "source": "/leaderboard/:archetype", "destination": "/leaderboard.html?archetype=:archetype" },
    { "source": "/leaderboard", "destination": "/leaderboard.html" },
    { "source": "/match", "destination": "/match.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/card", "destination": "/api/card" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://www.slashvibe.dev; font-src 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/weekly-digest", "schedule": "0 13 * * 1" }
  ]
}
